#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: framecopy [-e both|left|right] [-s WxH] [-f fps] [-b bitrate] [user@host]" >&2
  exit 2
}

eye=both
size=
fps=30
bitrate=6M
while getopts e:s:f:b: opt; do
  case $opt in
    e) eye=$OPTARG ;;
    s) size=$OPTARG ;;
    f) fps=$OPTARG ;;
    b) bitrate=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
host=${1:-steamos@frame}
dir=$(dirname "$(readlink -f "$0")")

[[ $eye =~ ^(both|left|right)$ ]] || usage
[[ $fps =~ ^[0-9]+$ ]] || usage
[[ $bitrate =~ ^[0-9]+[kKmM]?$ ]] || usage
if [[ -z $size ]]; then
  [[ $eye == both ]] && size=1920x960 || size=960x960
fi
[[ $size =~ ^[0-9]+x[0-9]+$ ]] || usage

control=$(mktemp -d)
trap 'ssh -O exit "$host" 2>/dev/null; rm -r "$control"' EXIT
ssh() { command ssh -o ControlPath="$control/socket" "$@"; }
scp() { command scp -o ControlPath="$control/socket" "$@"; }
ssh -fNM "$host"

remote=$(ssh "$host" 'echo $HOME/.cache/framecopy')
ssh "$host" "mkdir -p $remote"

# build <name> <libs> <files...>
build() {
  local name=$1 libs=$2 sum srcs
  shift 2
  sum=$(cd "$dir/src" && cat "$@" | sha256sum | cut -d' ' -f1)
  if ssh "$host" "[ \"\$(cat $remote/$name.sum 2>/dev/null)\" = $sum ]"; then
    return
  fi
  srcs=$(printf '%s\n' "$@" | grep '\.c$' | tr '\n' ' ')
  # Copies from the nix store are read-only, so scp cannot overwrite them.
  ssh "$host" "cd $remote && rm -f $*"
  (cd "$dir/src" && scp -q "$@" "$host:$remote/")
  ssh "$host" "cd $remote &&
    gcc -O2 -Wall -Wextra -fstack-protector-strong -D_FORTIFY_SOURCE=2 -o $name $srcs $libs &&
    echo $sum > $name.sum"
}
build framecopy-kms '$(pkg-config --cflags --libs libdrm)' kms.c proto.c proto.h util.h
build framecopy-capture -lvulkan capture.c clock.h enc.c enc.h gpu.c gpu.h proto.c proto.h util.h

if ! ssh "$host" "getcap $remote/framecopy-kms" | grep -q cap_sys_admin; then
  echo "run once: ssh -t $host sudo setcap cap_sys_admin+ep $remote/framecopy-kms" >&2
  exit 1
fi

# The encoder writes full range BT.709 but labels it limited range.
ssh "$host" "$remote/framecopy-capture -e $eye -s $size -f $fps -b $bitrate" |
  mpv --profile=low-latency --no-cache --untimed --no-osc --osd-level=0 --hwdec=auto --vd-lavc-o=flags=+low_delay \
    --demuxer-lavf-format=hevc --no-correct-pts --container-fps-override=$fps \
    --vf=format=colorlevels=full:colormatrix=bt.709 --title=framecopy -
