#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D src;
layout(binding = 1) writeonly buffer Frame
{
    uint words[];
};
layout(push_constant) uniform Layout
{
    uvec2 blocks;
    uint stride;
    uint uv;
};

const vec3 KR = vec3(0.2126, 0.7152, 0.0722);

uint to_byte(float v)
{
    return uint(round(v));
}

void main()
{
    uvec2 b = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(b, blocks)))
        return;

    ivec2 p = ivec2(b * uvec2(4, 2));
    uint luma[2] = uint[2](0, 0);
    vec3 sum[2] = vec3[2](vec3(0), vec3(0));
    for (int j = 0; j < 2; j++) {
        for (int i = 0; i < 4; i++) {
            vec3 c = imageLoad(src, p + ivec2(i, j)).rgb;
            luma[j] |= to_byte(16 + 219 * dot(KR, c)) << (8 * i);
            sum[i / 2] += c;
        }
    }

    uint chroma = 0;
    for (int k = 0; k < 2; k++) {
        vec3 c = sum[k] / 4;
        float y = dot(KR, c);
        chroma |= to_byte(128 + 224 * (c.b - y) / 1.8556) << (16 * k);
        chroma |= to_byte(128 + 224 * (c.r - y) / 1.5748) << (16 * k + 8);
    }

    words[p.y * stride + b.x] = luma[0];
    words[(p.y + 1) * stride + b.x] = luma[1];
    words[uv + b.y * stride + b.x] = chroma;
}
